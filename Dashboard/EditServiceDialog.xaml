<Window x:Class="ServiceManager.Dashboard.EditServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Service" Width="500" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PanelBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Name (read-only) -->
        <TextBlock Grid.Row="0" Text="Name" Foreground="{StaticResource DefaultText}"
                   FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                 Background="#3c3c3c" Foreground="{StaticResource ValueText}"
                 FontFamily="Consolas" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

        <!-- Command -->
        <TextBlock Grid.Row="1" Text="Command" Foreground="{StaticResource DefaultText}"
                   FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtCommand" Grid.Row="1" Grid.Column="1"
                 Background="#2d2d2d" Foreground="{StaticResource DefaultText}"
                 FontFamily="Consolas" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 CaretBrush="{StaticResource DefaultText}"/>

        <!-- Working Directory -->
        <TextBlock Grid.Row="2" Text="Directory" Foreground="{StaticResource DefaultText}"
                   FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtWorkDir" Grid.Row="2" Grid.Column="1"
                 Background="#2d2d2d" Foreground="{StaticResource DefaultText}"
                 FontFamily="Consolas" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 CaretBrush="{StaticResource DefaultText}"/>

        <!-- Auto Start -->
        <TextBlock Grid.Row="3" Text="Auto Start" Foreground="{StaticResource DefaultText}"
                   FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <CheckBox x:Name="ChkAutoStart" Grid.Row="3" Grid.Column="1"
                  VerticalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{StaticResource DangerButton}" Padding="16,6"
                    Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="Save" Style="{StaticResource ToolbarButton}" Padding="16,6"
                    Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
