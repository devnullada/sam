<Window x:Class="ServiceManager.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAM - Service Manager" Width="1000" Height="600"
        Icon="app.ico"
        Background="{StaticResource MainBg}">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0">
                    <Button x:Name="BtnStartServer" Content="Start Server" Style="{StaticResource ToolbarButton}" Click="OnStartServer" Margin="0,0,4,0"/>
                    <Button x:Name="BtnStopServer" Content="Stop Server" Style="{StaticResource DangerButton}" Click="OnStopServer" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ServerStatusIcon" Text="●" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource StoppedText}"/>
                    <TextBlock x:Name="ServerStatusText" Text="SERVER OFFLINE" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource StoppedText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.28*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.72*"/>
            </Grid.ColumnDefinitions>

            <!-- Services list -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="4,4">
                        <Button x:Name="BtnStart" DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Click="OnStart" ToolTip="Start">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnStop" DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Click="OnStop" ToolTip="Stop">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnNewService" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="OnNewService" ToolTip="Add new service">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="New" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ListBox x:Name="ServiceList" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource DefaultText}"
                             FontFamily="Consolas" FontSize="17"
                             SelectionChanged="OnServiceSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="Dot" Text="&#x25CF;" Margin="4,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RunningText}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel x:Name="RowActions" Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Visibility="Hidden">
                                        <Button Style="{StaticResource ItemIconButton}" Click="OnEditConfig"
                                                ToolTip="Edit service">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource ItemIconButton}" Click="OnDeleteService"
                                                ToolTip="Delete service">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter TargetName="Dot" Property="Text" Value="&#x25CB;"/>
                                        <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource BorderBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="RowActions" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Right panel -->
            <DockPanel Grid.Column="2">
                <!-- Info bar -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PID: " Foreground="{StaticResource DefaultText}" FontFamily="Consolas" FontSize="13"/>
                        <TextBlock x:Name="PidText" Text="-" Foreground="{StaticResource ValueText}" FontFamily="Consolas" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Text="Uptime: " Foreground="{StaticResource DefaultText}" FontFamily="Consolas" FontSize="13"/>
                        <TextBlock x:Name="UptimeText" Text="-" Foreground="{StaticResource ValueText}" FontFamily="Consolas" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Text="Status: " Foreground="{StaticResource DefaultText}" FontFamily="Consolas" FontSize="13"/>
                        <TextBlock x:Name="StatusText" Text="-" FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Output header -->
                <DockPanel DockPanel.Dock="Top" Margin="10,6">
                    <TextBlock Text="OUTPUT"
                               Foreground="{StaticResource HeaderText}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnCopyOutput" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            ToolTip="Copy output to clipboard" Click="OnCopyOutput"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource HeaderText}"
                            Padding="4,2" Cursor="Hand"/>
                    <Button x:Name="BtnClearOutput" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            ToolTip="Clear output" Click="OnClearOutput"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource HeaderText}"
                            Padding="4,2" Cursor="Hand"/>
                </DockPanel>

                <!-- Output area -->
                <RichTextBox x:Name="OutputBox" Background="{StaticResource MainBg}"
                             Foreground="{StaticResource DefaultText}"
                             FontFamily="Consolas" FontSize="14"
                             BorderThickness="0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="8,4">
                    <RichTextBox.Document>
                        <FlowDocument PageWidth="10000">
                            <Paragraph x:Name="OutputParagraph"/>
                        </FlowDocument>
                    </RichTextBox.Document>
                </RichTextBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
